[Desktop Entry]
Version=1.0
Type=Application
Name=Mail Cat
GenericName=Email Client
Comment=Fast email client built with Rust and Tauri
Exec=mail-cat-ui %u
Icon=mail-cat
Terminal=false
Categories=Network;Email;
MimeType=x-scheme-handler/mailto;
Keywords=email;mail;imap;
StartupWMClass=mail-cat-ui
StartupNotify=true
