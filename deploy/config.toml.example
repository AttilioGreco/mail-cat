# mail-cat server configuration
# Copia questo file in ~/.config/mail-cat/config.toml e modifica i valori.

# Indirizzo su cui il server gRPC ascolta.
# Default: 127.0.0.1:50051
grpc_addr = "127.0.0.1:50051"

# Path del database sled.
# Default: ~/.local/share/mail-cat/db
# db_path = "/home/utente/.local/share/mail-cat/db"

# Path dell'indice Tantivy (ricerca full-text).
# Default: ~/.local/share/mail-cat/index
# index_path = "/home/utente/.local/share/mail-cat/index"

# Path del binario mail-cat-ui, lanciato quando si clicca "Apri Mail Cat"
# in una notifica desktop.
# Default: ~/.local/bin/mail-cat-ui  (posizione usata da `just install`)
# ui_bin = "/home/utente/.local/bin/mail-cat-ui"

# Livello di log, direttiva tracing_subscriber::EnvFilter (es. "info",
# "debug", o granulare "mc_server=debug,tower=warn").
# La variabile d'ambiente RUST_LOG, se impostata, ha SEMPRE la precedenza
# su questo valore (utile per un debug estemporaneo senza toccare il file).
# Serve per lasciare acceso un livello di debug permanente (es. in produzione
# dopo un bug intermittente) senza dover ricordarsi di esportare RUST_LOG
# ad ogni riavvio/restart del servizio (systemd, boot, ecc.).
# Default: mc_server=info,mc_application=debug,mc_infrastructure=debug
# log_level = "info"

# ── Account email ────────────────────────────────────────────────────────────
# Aggiungere un blocco [[accounts]] per ogni casella da sincronizzare.

[[accounts]]
name        = "Personal"
email       = "tuo@indirizzo.it"
provider_type = "imap"          # "imap" | "gmail_api" | "outlook_api"

imap_host   = "imap.example.com"
imap_port   = 993
use_tls     = true

smtp_host   = "smtp.example.com"
smtp_port   = 587

username    = "tuo@indirizzo.it"
password    = "password_o_app_password"

# Megabyte che questo account può scaricare in 24 ore. La sync iniziale
# scarica solo gli envelope; i corpi (solo il testo, mai gli allegati, che si
# scaricano quando servono) arrivano dopo, dal più recente: la prima metà
# del tetto a velocità piena, il resto distribuito sulla giornata.
# Default: 2000 per Gmail (tetto 2,5 GB/giorno, oltre blocca l'account),
# illimitato per gli altri. `0` = illimitato.
# daily_download_mb = 2000

# [[accounts]]
# name      = "Work"
# email     = "work@company.com"
# ...
