{
  "$schema": "https://tauri.app/schema/config/2.2.0",
  "productName": "mail-cat",
  "version": "0.1.0",
  "identifier": "com.mailcat.app",
  "build": {
    "frontendDist": "src-ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "../../../scripts/build-frontend.sh"
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "files": {
          "/usr/bin/mail-cat-server": "../../target/release/mail-cat-server",
          "/usr/bin/mc": "../../target/release/mc",
          "/usr/lib/systemd/user/mail-cat-server.service": "../../packaging/systemd/mail-cat-server.service",
          "/usr/share/mail-cat/config.toml.example": "../../deploy/config.toml.example"
        }
      },
      "rpm": {
        "depends": [],
        "files": {
          "/usr/bin/mail-cat-server": "../../target/release/mail-cat-server",
          "/usr/bin/mc": "../../target/release/mc",
          "/usr/lib/systemd/user/mail-cat-server.service": "../../packaging/systemd/mail-cat-server.service",
          "/usr/share/mail-cat/config.toml.example": "../../deploy/config.toml.example"
        }
      }
    }
  },
  "app": {
    "windows": [
      {
        "title": "mail-cat Email Client",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline';"
    }
  }
}
