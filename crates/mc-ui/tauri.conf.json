{
  "$schema": "https://tauri.app/schema/config/2.2.0",
  "productName": "mail-cat",
  "version": "0.1.1",
  "identifier": "com.mailcat.app",
  "build": {
    "frontendDist": "src-ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "../../../scripts/build-frontend.sh"
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true,
    "shortDescription": "Email client with background sync"
  },
  "app": {
    "windows": [
      {
        "title": "mail-cat Email Client",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline';"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBQTAzQzc1OTgyMDgzODgKUldTSWd5Q1lkVHlnV3JKbHNwOVdSZTJDTlFEYlhBbjRtcENFbmtLYVJnNG8yNjFQMkJMWnA4YzMK",
      "endpoints": [
        "https://github.com/AttilioGreco/mail-cat/releases/latest/download/latest.json"
      ]
    }
  },
  "mainBinaryName": "mail-cat-ui"
}
